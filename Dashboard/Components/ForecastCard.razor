@using Dashboard.Models

@if (Forecast is not null)
{
    <div class="forecast-card">
        <h4>@Forecast.Day.ToString("ddd")</h4>
        <p>@Forecast.Description</p>
        <p>High: @Math.Round(Forecast.MaxTemp)@TemperatureSymbol</p>
        <p>Low: @Math.Round(Forecast.MinTemp)@TemperatureSymbol</p>
        <p>Precip: @Forecast.PrecipitationSum</p>
    </div>
}

@code {
    [Parameter] public DailyForecastDto? Forecast { get; set; }
    [Parameter] public string TemperatureSymbol { get; set; } = "F";
}
