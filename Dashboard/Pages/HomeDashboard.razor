@page "/dashboard"
@using Dashboard.Models
@using Dashboard.Components
@inject HttpClient Http
@inject ApiClient ApiClient

<PageTitle>Dashboard</PageTitle>

<div>
    <label>Zip Code:</label>
    <input @bind="zip" />
</div>

<div>
    <label>Country:</label>
    <select @bind="countryCode">
        <option value="">-- Select Country --</option>
        @foreach (var country in countries)
        {
            <option value="@country.Code">@country.Name</option>
        }
    </select>
</div>

<button @onclick="LoadWeather">Search</button>

@if (!string.IsNullOrWhiteSpace(validationError))
{
    <p style="color:red">@validationError</p>
}

@if (dashboard is null)
{
    <p>No data loaded.</p>
}
else if (!dashboard.Success || dashboard.Value is null)
{
    <p>Dashboard data could not be loaded.</p>

    @if (!string.IsNullOrWhiteSpace(dashboard.Error))
    {
        <p>Error: @dashboard.Error</p>
    }
}
else
{
    @if (dashboard.Value.Weather is not null)
    {
        <h3 class="page-title">@dashboard.Value.Weather.Name Weather</h3>

        <div class="weather-page">
            <div class="current-weather-wrapper">
                <CurrentWeatherPanel
                    LocationName="@dashboard.Value.Weather.Name"
                    Current="@dashboard.Value.Weather.Current" />
            </div>

            <div class="forecast-row">
                @foreach (var item in dashboard.Value.Weather.Forecast)
                {
                    <ForecastCard Forecast="@item" />
                }
            </div>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(dashboard.Value.WeatherError))
    {
        <p style="color:red">Weather error: @dashboard.Value.WeatherError</p>
    }

    <hr/>

    <NewsPanel Articles= "@(dashboard.Value.News)" Error= "@(dashboard.Value.NewsError)"/>

}

@code {
    private Result<DashboardDto>? dashboard;
    private string zip = "47546";
    private string countryCode = "US";

    private List<CountryOption> countries = new();
    private string? validationError;

    protected override async Task OnInitializedAsync()
    {
        countries = await Http.GetFromJsonAsync<List<CountryOption>>("data/countries.json")
                    ?? new List<CountryOption>();
    }

    private async Task LoadWeather()
    {
        if (!IsValidInput())
            return;

        dashboard = await ApiClient.Http.GetFromJsonAsync<Result<DashboardDto>>(
            $"/?zip={Uri.EscapeDataString(zip)}&countryCode={Uri.EscapeDataString(countryCode)}");
    }

    private bool IsValidInput()
    {
        zip = zip.Trim();
        countryCode = countryCode.Trim();

        if (string.IsNullOrWhiteSpace(zip))
        {
            validationError = "Zip code is required.";
            return false;
        }

        if (string.IsNullOrWhiteSpace(countryCode))
        {
            validationError = "Please select a country.";
            return false;
        }

        validationError = null;
        return true;
    }
}
