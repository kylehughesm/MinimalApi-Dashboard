@page "/weather"
@using Dashboard.Models
@using Dashboard.Components
@inject HttpClient Http
@inject ApiClient ApiClient

<PageTitle>Weather</PageTitle>

<div>
    <label>Zip Code:</label>
    <input @bind="zip" />
</div>

<div>
    <label>Country:</label>
    <select @bind="countryCode">
        <option value="">-- Select Country --</option>
        @foreach (var country in countries)
        {
            <option value="@country.Code">@country.Name</option>
        }
    </select>
</div>

<button @onclick="LoadWeather">Search</button>

@if (!string.IsNullOrWhiteSpace(validationError))
{
    <p style="color:red">@validationError</p>
}

@if (weather is null)
{
    <p>No weather loaded.</p>
}
else if (!weather.Success || weather.Value is null || weather.Value.Current is null)
{
    <p>Weather data could not be loaded.</p>

    @if (!string.IsNullOrWhiteSpace(weather.Error))
    {
        <p>Error: @weather.Error</p>
    }
}
else
{
    <h3 class="page-title">@weather.Value.Name Weather</h3>

    <div class="weather-page">
        <div class="current-weather-wrapper">
            <CurrentWeatherPanel
                LocationName="@weather.Value.Name"
                Current="@weather.Value.Current" />
        </div>

        <div class="forecast-row">
            @foreach (var item in weather.Value.Forecast)
            {
                <ForecastCard Forecast="@item" />
            }
        </div>
    </div>
}

@code {
    private WeatherResponseDto? weather;
    private string zip = "47546";
    private string countryCode = "US";

    private List<CountryOption> countries = new();

    private string? validationError;

    protected override async Task OnInitializedAsync()
    {
        countries = await Http.GetFromJsonAsync<List<CountryOption>>("data/countries.json")
                    ?? new List<CountryOption>();
    }

    private async Task LoadWeather()
    {
        if (!IsValidInput())
            return;

        weather = await ApiClient.Http.GetFromJsonAsync<WeatherResponseDto>(
            $"/?zip={Uri.EscapeDataString(zip)}&countryCode={Uri.EscapeDataString(countryCode)}");
    }

    private bool IsValidInput()
    {
        zip = zip.Trim();
        countryCode = countryCode.Trim();

        if (string.IsNullOrWhiteSpace(zip))
        {
            validationError = "Zip code is required.";
            return false;
        }

        if (string.IsNullOrWhiteSpace(countryCode))
        {
            validationError = "Please select a country.";
            return false;
        }

        validationError = null;
        return true;
    }
}
